# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/rupaykg
MONGO_URI=

# Gemini API Key for AI Risk Assessment
GEMINI_API_KEY=

# External Carbon Registry API (Optional)
# Get a carbon registry API from platforms like Verra, Gold Standard, or EcoRegistry.
CARBON_REGISTRY_API_URL=
CARBON_REGISTRY_API_KEY=

# Hedera Guardian API (Optional)
# Learn more about Hedera Guardian and get your API credentials at: https://hedera.com
# Documentation: https://github.com/hashgraph/guardian
GUARDIAN_API_URL=
GUARDIAN_API_KEY=

# Internal Service Token for metrics and health endpoints
INTERNAL_SERVICE_TOKEN=

# Allowed CORS Origins (comma-separated, e.g. http://localhost:3000)
ALLOWED_ORIGINS=

# PostgreSQL Database URL
DATABASE_URL=
